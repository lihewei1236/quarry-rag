# ============ 数据库 ============
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=quarry
POSTGRES_USER=quarry
POSTGRES_PASSWORD=quarry-local-dev-2026

# ============ Redis ============
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# ============ 模型档位 ============
# 默认配的是阿里云百炼北京地域的 OpenAI 兼容接口。
# 换供应商只改这几行，业务代码一行不动。对照值见课件 2.3。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxx-REPLACE-ME

MODEL_EMBED=text-embedding-v4
EMBED_DIM=1024

# api = 真实调用；fake = 确定性哈希伪向量，不需要密钥
EMBED_BACKEND=api

# ============ 应用 ============
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_TOP_K=8

# ============ 重排（第五章） ============
# noop = 不重排（默认，也是对照组）；api = 调用托管重排接口
RERANK_BACKEND=noop
RERANK_MODEL=qwen3-rerank
# 百炼的重排接口地址，5.2.3 会先用命令行验证一遍
RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
# 留空就复用上面的 LLM_API_KEY
RERANK_API_KEY=
RERANK_CANDIDATES=30
RERANK_TIMEOUT_S=3.0

# ============ 上下文（第五章） ============
CONTEXT_MAX_CHARS=6000
NEIGHBOR_RADIUS=1

# ============ 事实层（第六章） ============
FACT_MODEL=qwen-flash
# 百炼北京地域的 OpenAI 兼容地址，和第一章的向量化同一个入口
FACT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 留空就复用 LLM_API_KEY
FACT_API_KEY=
FACT_CONCURRENCY=4
FACT_TIMEOUT_S=30
# 官方核实日期超过这么多天，状态变为 expired
FACT_TTL_DAYS=90